NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ezehlabs
DATABASE_SSL=false
APP_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Required to send verification emails. Registration remains unverified until
# the email link is used. Do not commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EzehLabs <hello@ezehlabs.com>
